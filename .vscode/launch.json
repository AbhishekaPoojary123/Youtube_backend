{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Backend",
            "cwd": "${workspaceFolder}/backend",
            "program": "${workspaceFolder}/backend/src/index.js",
            "envFile": "${workspaceFolder}/backend/.env",
            "runtimeArgs": [
                "-r",
                "dotenv/config"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}